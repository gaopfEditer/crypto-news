{
  "_comment": "news_dashboard 配置（由 news_watch/config.json 复制并扩展）。修改后重启 server.py 生效。打分/关键词规则与 news_watch 相同。",
  "dashboard": {
    "host": "127.0.0.1",
    "port": 5190,
    "poll_seconds": 180,
    "retain_hours": 48,
    "seed_hours": 12,
    "data_dir": "data",
    "price_for_low": true,
    "_note": "price_for_low: 低分条目也取价(仅 Binance，CoinGecko 兜底只给命中条目，避免限流)"
  },
  "threshold": 7,
  "big_threshold": 7,
  "cluster_hours": 6,
  "cross_confirm_bonus": 1,
  "breaking_tag_bonus": 1,
  "summary_factor": 0.3,
  "source_fail_alert_after": 8,
  "sources": {
    "coindesk": {
      "enabled": true,
      "type": "rss",
      "label": "CoinDesk",
      "url": "https://www.coindesk.com/arc/outboundfeeds/rss"
    },
    "theblock": {
      "enabled": true,
      "type": "rss",
      "label": "The Block",
      "url": "https://www.theblock.co/rss.xml"
    },
    "odaily": {
      "enabled": true,
      "type": "odaily",
      "label": "Odaily",
      "first_run_ids": 60,
      "max_ids_per_run": 150,
      "seed_ids": 220
    },
    "panews": {
      "enabled": true,
      "type": "panews",
      "label": "PANews",
      "take": 50
    }
  },
  "tokens": {
    "BTC": {
      "names": [
        "Bitcoin",
        "比特币"
      ],
      "weight": 2,
      "gecko": "bitcoin"
    },
    "ETH": {
