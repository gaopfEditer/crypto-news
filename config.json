    "enabled": true,
    "weight": 3,
    "max_age_days": 14,
    "trackers": {
      "unlock_tracker": "unlocks.csv",
      "delist_tracker": "delistings.csv",
      "futures_listing_tracker": "listings.csv",
      "burn_tracker": "burns.csv"
